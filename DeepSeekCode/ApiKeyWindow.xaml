<Window x:Class="DeepSeekCode.ApiKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置 DeepSeek API Key"
        Width="480" Height="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceWhiteBrush}"
        BorderBrush="{StaticResource BorderDefaultBrush}"
        BorderThickness="1">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="DeepSeek Code"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBlueBrush}"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="请输入你的 DeepSeek API Key，可在 platform.deepseek.com 获取。"
                   FontSize="13"
                   Foreground="{StaticResource PrimaryLightBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="API Key" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,4"/>
            <PasswordBox x:Name="ApiKeyBox"
                         Background="White"
                         Foreground="{StaticResource PrimaryDarkBrush}"
                         BorderThickness="0"
                         FontSize="14"
                         Padding="8,6"
                         CaretBrush="{StaticResource PrimaryDarkBrush}">
                <PasswordBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </PasswordBox.Resources>
            </PasswordBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,80,0,0">
            <TextBlock Text="API Base URL (可选)" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="BaseUrlBox"
                     Text="https://api.deepseek.com"
                     Background="White"
                     Foreground="{StaticResource PrimaryDarkBrush}"
                     BorderThickness="0"
                     FontSize="14"
                     Padding="8,6"
                     CaretBrush="{StaticResource PrimaryDarkBrush}">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="退出"
                    Click="CancelButton_Click"
                    Width="80" Height="34"
                    Background="White"
                    Foreground="{StaticResource PrimaryDarkBrush}"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="确认"
                    Click="ConfirmButton_Click"
                    Width="80" Height="34"
                    Background="{StaticResource PrimaryBlueBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
