<Window x:Class="DeepSeekCode.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek 设置"
        Width="580" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceWhiteBrush}"
        BorderBrush="{StaticResource BorderDefaultBrush}"
        BorderThickness="1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="Transparent" BorderBrush="{StaticResource BorderDefaultBrush}">

            <!-- ═══ Tab 0: 账户 ═══ -->
            <TabItem Header="账户" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource PrimaryDarkBrush}">
                <StackPanel Margin="16,12">
                    <TextBlock Text="API Key" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox" Grid.Column="0"
                                     Background="White"
                                     Foreground="{StaticResource PrimaryDarkBrush}"
                                     BorderThickness="0" Height="34" FontSize="14"
                                     Padding="8,4"
                                     CaretBrush="{StaticResource PrimaryDarkBrush}"
                                     PasswordChar="•">
                            <PasswordBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </PasswordBox.Resources>
                        </PasswordBox>
                        <Button x:Name="ToggleApiKeyBtn" Grid.Column="1"
                                Content="👁"
                                Click="ToggleApiKeyVisibility_Click"
                                Width="36" Height="34"
                                Background="Transparent"
                                Foreground="{StaticResource PrimaryLightBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FontSize="14"
                                Margin="4,0,0,0"
                                ToolTip="显示/隐藏 API Key"/>
                    </Grid>
                    <TextBlock Text="在 platform.deepseek.com 获取你的 API Key"
                               Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,4,0,16"/>

                    <TextBlock Text="API Base URL" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBox x:Name="BaseUrlBox"
                             Background="White"
                             Foreground="{StaticResource PrimaryDarkBrush}"
                             BorderThickness="0" Height="34" FontSize="14"
                             Padding="8,4"
                             CaretBrush="{StaticResource PrimaryDarkBrush}">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="自定义 API 端点地址，留空使用官方默认地址"
                               Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,4,0,16"/>

                    <Border Background="White" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource PrimaryLightBrush}" FontSize="12" TextWrapping="Wrap">
                            API Key 在磁盘上以 Windows DPAPI 加密存储，仅当前 Windows 用户可解密。
                        </TextBlock>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Tab 1: 模型 ═══ -->
            <TabItem Header="模型" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource PrimaryDarkBrush}">
                <StackPanel Margin="16,12">
                    <TextBlock Text="选择模型" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox x:Name="ModelCombo" Background="White" Foreground="{StaticResource PrimaryDarkBrush}"
                              BorderThickness="0" Height="32" FontSize="14"
                              SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="DeepSeek V4 Pro" Tag="deepseek-v4-pro"/>
                        <ComboBoxItem Content="DeepSeek V4 Flash" Tag="deepseek-v4-flash"/>
                    </ComboBox>
                    <TextBlock Text="Pro: 高精度 / Flash: 快速响应" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,4,0,16"/>

                    <TextBlock Text="最大输出 Token" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MaxTokensBox" Grid.Column="0"
                                 Background="White" Foreground="{StaticResource PrimaryDarkBrush}"
                                 BorderThickness="0" Height="32" FontSize="14"
                                 Padding="8,4" TextChanged="OnSettingChanged"/>
                        <TextBlock Grid.Column="1" Text="最大 384,000"
                                   Foreground="{StaticResource PrimaryLightBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
            </TabItem>

            <!-- ═══ Tab 2: Thinking ═══ -->
            <TabItem Header="Thinking" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource PrimaryDarkBrush}">
                <StackPanel Margin="16,12">
                    <CheckBox x:Name="ThinkingToggle" Content="启用 Thinking 模式"
                              Foreground="{StaticResource PrimaryDarkBrush}" FontSize="14" Margin="0,0,0,12"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                    <TextBlock Text="推理强度" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox x:Name="EffortCombo" Background="White" Foreground="{StaticResource PrimaryDarkBrush}"
                              BorderThickness="0" Height="32" FontSize="14"
                              SelectionChanged="OnSettingChanged">
                        <ComboBoxItem Content="High" Tag="high"/>
                        <ComboBoxItem Content="Max（默认）" Tag="max"/>
                    </ComboBox>
                    <TextBlock Text="Agent 场景（如 Claude Code）自动使用 Max 级别" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,4,0,16"/>

                    <Border Background="White" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource WarningOrangeBrush}" FontSize="12" TextWrapping="Wrap">
                            Thinking 模式下 temperature / top_p / presence_penalty / frequency_penalty 无效。
                            这些参数可在「生成参数」页设置，但仅非 Thinking 模式生效。
                        </TextBlock>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ═══ Tab 3: 生成参数 ═══ -->
            <TabItem Header="生成参数" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource PrimaryDarkBrush}">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Temperature（温度）" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="TempSlider" Grid.Column="0"
                                Minimum="0" Maximum="2" SmallChange="0.1" LargeChange="0.2"
                                ValueChanged="TempSlider_ValueChanged"/>
                        <TextBlock x:Name="TempLabel" Grid.Column="1" Text="0.7"
                                   Foreground="{StaticResource PrimaryBlueBrush}" FontSize="14" FontWeight="Bold"
                                   Width="40" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="越高输出越随机，越低越确定性" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,0,0,16"/>

                    <TextBlock Text="Top-P" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="TopPSlider" Grid.Column="0"
                                Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                ValueChanged="TopPSlider_ValueChanged"/>
                        <TextBlock x:Name="TopPLabel" Grid.Column="1" Text="1.0"
                                   Foreground="{StaticResource PrimaryBlueBrush}" FontSize="14" FontWeight="Bold"
                                   Width="40" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="核采样阈值，1.0 表示不限制" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,0,0,16"/>

                    <TextBlock Text="Frequency Penalty（频率惩罚）" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FreqSlider" Grid.Column="0"
                                Minimum="-2" Maximum="2" SmallChange="0.1" LargeChange="0.2"
                                ValueChanged="FreqSlider_ValueChanged"/>
                        <TextBlock x:Name="FreqLabel" Grid.Column="1" Text="0.0"
                                   Foreground="{StaticResource PrimaryBlueBrush}" FontSize="14" FontWeight="Bold"
                                   Width="40" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="抑制重复内容，>0 减少重复" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,0,0,16"/>

                    <TextBlock Text="Presence Penalty（存在惩罚）" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="PresSlider" Grid.Column="0"
                                Minimum="-2" Maximum="2" SmallChange="0.1" LargeChange="0.2"
                                ValueChanged="PresSlider_ValueChanged"/>
                        <TextBlock x:Name="PresLabel" Grid.Column="1" Text="0.0"
                                   Foreground="{StaticResource PrimaryBlueBrush}" FontSize="14" FontWeight="Bold"
                                   Width="40" TextAlignment="Right"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="鼓励新话题，>0 增加多样性" Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="0,0,0,16"/>
                </StackPanel>
            </TabItem>

            <!-- ═══ Tab 4: Beta ═══ -->
            <TabItem Header="Beta" Background="{StaticResource SurfaceCardBrush}" Foreground="{StaticResource PrimaryDarkBrush}">
                <StackPanel Margin="16,12">
                    <CheckBox x:Name="JsonOutputToggle" Content="JSON 输出模式"
                              Foreground="{StaticResource PrimaryDarkBrush}" FontSize="14" Margin="0,0,0,8"
                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                    <TextBlock Text="强制模型以 JSON 格式输出（需在 prompt 中说明格式）"
                               Foreground="{StaticResource PrimaryLightBrush}" FontSize="11" Margin="24,0,0,16"/>

                    <Border Background="White" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource PrimaryLightBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="功能状态："/>
                            <TextBlock Foreground="{StaticResource PrimaryBlueBrush}" FontSize="12" Margin="0,4,0,0"
                                       Text="✅ JSON Output · ✅ Tool Calls · ✅ Context Caching"/>
                            <TextBlock Foreground="{StaticResource WarningOrangeBrush}" FontSize="12" Margin="0,2,0,0"
                                       Text="⚠ FIM Completion (Beta, 仅 Non-Thinking)"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Click="CancelButton_Click"
                    Width="80" Height="34"
                    Background="White" Foreground="{StaticResource PrimaryDarkBrush}"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="保存" Click="SaveButton_Click"
                    Width="80" Height="34"
                    Background="{StaticResource PrimaryBlueBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
