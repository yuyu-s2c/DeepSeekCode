<Window x:Class="DeepSeekCode.Services.PermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="权限确认"
        Width="440" Height="220"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        BorderBrush="#d8e6f2"
        BorderThickness="1">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text=" 工具需要权限确认"
                       Foreground="#1a2a38"
                       FontSize="14" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 内容 -->
        <TextBlock Grid.Row="1"
                   x:Name="PermissionMessage"
                   Text="..."
                   Foreground="#4a6070"
                   FontSize="13"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="拒绝"
                    Click="DenyButton_Click"
                    Width="70" Height="30"
                    Background="Transparent"
                    Foreground="#c04040"
                    FontSize="12"
                    BorderBrush="#d0e0f0"
                    BorderThickness="1"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="允许本次"
                    Click="AllowButton_Click"
                    Width="80" Height="30"
                    Background="#38a0e0"
                    Foreground="White"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,8,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="允许所有"
                    Click="AllowAllButton_Click"
                    Width="80" Height="30"
                    Background="#58a058"
                    Foreground="White"
                    FontSize="12"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="本轮对话中不再询问权限">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
